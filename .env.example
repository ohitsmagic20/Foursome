# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "secret" key (sb_secret_...) or the legacy "service_role" key.
# This key stays on the server. Never put it in client code.
SUPABASE_SECRET_KEY=

# Duffel → Developers → Access tokens. A test token (duffel_test_...) returns sample airlines for free.
DUFFEL_ACCESS_TOKEN=

# Resend → API Keys (Sending access, domain foresomes.net). Turns on trip emails. Optional.
RESEND_API_KEY=

# Any long random string. Lets only Vercel's scheduler run the daily job. Optional.
CRON_SECRET=

# Google Maps Platform API key with "Places API (New)" enabled. Shows Google star ratings for nearby courses. Optional.
GOOGLE_MAPS_API_KEY=
# Rating lookups allowed per day (each Golf tab view is one). 30/day stays within Google's free monthly amount.
GOOGLE_PLACES_DAILY_LIMIT=30
