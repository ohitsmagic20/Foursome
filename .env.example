# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "secret" key (sb_secret_...) or the legacy "service_role" key.
# This key stays on the server. Never put it in client code.
SUPABASE_SECRET_KEY=

# Duffel → Developers → Access tokens. A test token (duffel_test_...) returns sample airlines for free.
DUFFEL_ACCESS_TOKEN=
